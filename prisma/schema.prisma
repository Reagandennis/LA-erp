generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  name           String
  passwordHash   String
  status         String     @default("active")
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userRoles      UserRole[]
  userModules    UserModule[]
  personalTodos  PersonalTodo[]
  personalTodoBoard PersonalTodoBoard?
  personalTodoAttachments PersonalTodoAttachment[]
  personalTodoShares PersonalTodoShare[]
  personalTodoNotifications PersonalTodoNotification[]
  personalTodoComments PersonalTodoComment[]
  sessions       Session[]
  auditLogs      AuditLog[] @relation("AuditActor")
  auditTargets   AuditLog[] @relation("AuditTarget")
  trips          Trip[]
  // Chat
  chatConversations ChatConversation[] @relation("ChatCreatedBy")
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
}

// ─── Chat Models ────────────────────────────────────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
}

model ChatConversation {
  id          Int              @id @default(autoincrement())
  type        ConversationType
  name        String?
  createdById Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation("ChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     ChatMember[]
  messages    ChatMessage[]

  @@index([createdAt])
}

model ChatMember {
  id             Int              @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]
  reactions      ChatReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ChatAttachment {
  id        Int         @id @default(autoincrement())
  messageId Int
  filename  String
  mimeType  String
  size      Int
  // For platform files: store bytes; for Drive links: leave null, use driveUrl
  content   Bytes?
  driveUrl  String?
  driveFileId String?
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model PersonalTodo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("Backlog")
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  tripId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  attachments PersonalTodoAttachment[]
  shares      PersonalTodoShare[]
  notifications PersonalTodoNotification[]
  comments    PersonalTodoComment[]
  subtasks    Json?

  @@index([userId, completed, dueDate])
  @@index([userId, createdAt])
  @@index([tripId])
}

model Trip {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  destination   String?
  imageUrl      String?
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryItems TripItineraryItem[]
  proposals     TripProposal[]
  invoices      TripInvoice[]
  clientPortals TripClientPortal[]
  tasks         PersonalTodo[]

  @@index([userId, status, startDate])
}

model TripItineraryItem {
  id            Int      @id @default(autoincrement())
  tripId        Int
  dayNumber     Int
  title         String
  itemType      String   @default("Note")
  location      String?
  startLocation String?
  endLocation   String?
  startTime     DateTime?
  endTime       DateTime?
  notes         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayNumber, sortOrder])
}

model TripProposal {
  id          Int      @id @default(autoincrement())
  tripId      Int
  title       String
  status      String   @default("draft")
  version     Int      @default(1)
  amountCents Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
}

model TripInvoice {
  id            Int      @id @default(autoincrement())
  tripId        Int
  invoiceNumber String
  status        String   @default("draft")
  amountCents   Int      @default(0)
  dueDate       DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@unique([invoiceNumber])
}

model TripClientPortal {
  id        Int      @id @default(autoincrement())
  tripId    Int
  token     String   @unique
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, isActive])
}

model PersonalTodoAttachment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoShare {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  todoId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PersonalTodoComment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  body      String
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId, createdAt])
}

model PersonalTodoBoard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  columns     Json
  columnColors Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String
  category    String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userModules UserModule[]

  @@index([category, sortOrder])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserModule {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String?
  actorUserId  Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}
