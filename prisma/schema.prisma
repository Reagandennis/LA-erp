generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  name           String
  passwordHash   String
  status         String     @default("active")
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userRoles      UserRole[]
  userModules    UserModule[]
  personalTodos  PersonalTodo[]
  personalTodoBoard PersonalTodoBoard?
  personalTodoAttachments PersonalTodoAttachment[]
  personalTodoShares PersonalTodoShare[]
  personalTodoNotifications PersonalTodoNotification[]
  personalTodoComments PersonalTodoComment[]
  sessions       Session[]
  auditLogs      AuditLog[] @relation("AuditActor")
  auditTargets   AuditLog[] @relation("AuditTarget")
}

model PersonalTodo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("Backlog")
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments PersonalTodoAttachment[]
  shares      PersonalTodoShare[]
  notifications PersonalTodoNotification[]
  comments    PersonalTodoComment[]
  subtasks    Json?

  @@index([userId, completed, dueDate])
  @@index([userId, createdAt])
}

model PersonalTodoAttachment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoShare {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  todoId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PersonalTodoComment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  body      String
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId, createdAt])
}

model PersonalTodoBoard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  columns     Json
  columnColors Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String
  category    String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userModules UserModule[]

  @@index([category, sortOrder])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserModule {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String?
  actorUserId  Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}
