generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  name           String
  passwordHash   String
  status         String     @default("active")
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userRoles      UserRole[]
  userModules    UserModule[]
  personalTodos  PersonalTodo[]
  personalTodoBoard PersonalTodoBoard?
  personalTodoAttachments PersonalTodoAttachment[]
  personalTodoShares PersonalTodoShare[]
  personalTodoNotifications PersonalTodoNotification[]
  personalTodoComments PersonalTodoComment[]
  sessions       Session[]
  auditLogs      AuditLog[] @relation("AuditActor")
  auditTargets   AuditLog[] @relation("AuditTarget")
  createdCustomers   Customer[] @relation("CustomerCreatedBy")
  createdQuotes      Quote[]    @relation("QuoteCreatedBy")
  approvableQuotes   Quote[]    @relation("QuoteApprover")
  quoteNotifications QuoteNotification[]
}

model PersonalTodo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("Backlog")
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments PersonalTodoAttachment[]
  shares      PersonalTodoShare[]
  notifications PersonalTodoNotification[]
  comments    PersonalTodoComment[]
  subtasks    Json?

  @@index([userId, completed, dueDate])
  @@index([userId, createdAt])
}

model PersonalTodoAttachment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoShare {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  todoId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PersonalTodoComment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  body      String
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId, createdAt])
}

model PersonalTodoBoard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  columns     Json
  columnColors Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String
  category    String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userModules UserModule[]

  @@index([category, sortOrder])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserModule {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String?
  actorUserId  Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotes      Quote[]

  @@index([createdById, createdAt])
  @@index([name])
}

model Quote {
  id            Int       @id @default(autoincrement())
  reference     String    @unique
  customerId    Int
  createdById   Int
  approverId    Int?
  subject       String
  status        String    @default("Draft")
  issueDate     DateTime
  expiryDate    DateTime
  taxRate       Decimal   @default(0) @db.Decimal(6, 4)
  subtotal      Decimal   @default(0) @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  notes         String?
  decisionNote  String?
  submittedAt   DateTime?
  decidedAt     DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User      @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approver      User?     @relation("QuoteApprover", fields: [approverId], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  notifications QuoteNotification[]

  @@index([createdById, status])
  @@index([approverId, status])
  @@index([customerId])
  @@index([status, expiryDate])
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  position    Int
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
}

model QuoteNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  quoteId   Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quoteId])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}
