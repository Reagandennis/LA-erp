generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             Int                              @id @default(autoincrement())
  email                          String                           @unique
  name                           String
  passwordHash                   String
  status                         String                           @default("active")
  sessionVersion                 Int                              @default(1)
  dashboardHighlights            String[]                         @default([])
  worldClockZones                String[]                         @default([])
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  userRoles                      UserRole[]
  userModules                    UserModule[]
  personalTodos                  PersonalTodo[]
  personalTodoBoard              PersonalTodoBoard?
  personalTodoAttachments        PersonalTodoAttachment[]
  personalTodoShares             PersonalTodoShare[]
  personalTodoNotifications      PersonalTodoNotification[]
  personalTodoComments           PersonalTodoComment[]
  sessions                       Session[]
  auditLogs                      AuditLog[]                       @relation("AuditActor")
  auditTargets                   AuditLog[]                       @relation("AuditTarget")
  createdCustomers               Customer[]                       @relation("CustomerCreatedBy")
  createdDeals                   Deal[]                           @relation("DealCreatedBy")
  createdCrmActivities           CrmActivity[]                    @relation("CrmActivityCreatedBy")
  quickbooksConnections          QuickBooksConnection[]           @relation("QuickBooksConnectedBy")
  waveConnections                WaveConnection[]                 @relation("WaveConnectedBy")
  messagingAccounts              MessagingAccount[]               @relation("MessagingAccountOwner")
  shiftTemplatesCreated          ShiftTemplate[]                  @relation("ShiftTemplateCreatedBy")
  shiftTemplateMemberships       ShiftTemplateMember[]            @relation("ShiftTemplateMemberUser")
  teamsCreated                   Team[]                           @relation("TeamCreatedBy")
  teamMemberships                TeamMember[]                     @relation("TeamMemberUser")
  leaveRequests                  LeaveRequest[]                   @relation("LeaveRequestUser")
  leaveDecisions                 LeaveRequest[]                   @relation("LeaveRequestDecidedBy")
  publicHolidaysCreated          PublicHoliday[]                  @relation("PublicHolidayCreatedBy")
  createdQuotes                  Quote[]                          @relation("QuoteCreatedBy")
  approvableQuotes               Quote[]                          @relation("QuoteApprover")
  quoteNotifications             QuoteNotification[]
  createdProducts                Product[]                        @relation("ProductCreatedBy")
  createdQuoteTemplates          QuoteTemplate[]                  @relation("QuoteTemplateCreatedBy")
  createdBrandProfiles           BrandProfile[]                   @relation("BrandProfileCreatedBy")
  createdInvoices                Invoice[]                        @relation("InvoiceCreatedBy")
  approvableInvoices             Invoice[]                        @relation("InvoiceApprover")
  invoiceNotifications           InvoiceNotification[]
  recordedInvoicePayments        InvoicePayment[]                 @relation("InvoicePaymentCreatedBy")
  organizationUpdates            OrganizationSettings[]           @relation("OrganizationUpdatedBy")
  createdTrips                   Trip[]                           @relation("TripCreatedBy")
  tripLogEntries                 TripLogEntry[]                   @relation("TripLogEntryCreatedBy")
  tripLogNotifications           TripLogNotification[]            @relation("TripLogNotificationUser")
  closedOutTrips                 TripCloseout[]                   @relation("TripCloseoutClosedBy")
  editedTripCloseouts            TripCloseout[]                   @relation("TripCloseoutUpdatedBy")
  tripShareLinks                 TripShareLink[]                  @relation("TripShareLinkCreatedBy")
  ownedTrips                     Trip[]                           @relation("TripOwner")
  tripItineraryItemNotifications TripItineraryItemNotification[]
  createdConversations           Conversation[]                   @relation("ConversationCreatedBy")
  conversationMembers            ConversationMember[]
  sentMessages                   Message[]                        @relation("MessageSender")
  messageNotifications           MessageNotification[]
  feedback                       Feedback[]                       @relation("FeedbackAuthor")
  feedbackUpvotes                FeedbackUpvote[]
  feedbackComments               FeedbackComment[]
  createdDriverLicenses          DriverLicense[]                  @relation("DriverLicenseCreatedBy")
  uploadedFiles                  StoredFile[]                     @relation("StoredFileUploadedBy")
  tripItemAttachments            TripItemAttachment[]             @relation("TripItemAttachmentUploadedBy")
  receivedFileShares             StoredFileShare[]
  fileNotifications              FileNotification[]
  calendarEvents                 CalendarEvent[]
  calendarEventNotifications     CalendarEventNotification[]
  scheduleShifts                 ScheduleShift[]                  @relation("ScheduleEmployee")
  createdScheduleShifts          ScheduleShift[]                  @relation("ScheduleCreatedBy")
  zelloActivities                ZelloActivity[]                  @relation("ZelloActivityRecordedBy")
  whatsAppMessages               WhatsAppMessage[]                @relation("WhatsAppMessageRecordedBy")
  createdVehicles                Vehicle[]                        @relation("VehicleCreatedBy")
  createdVehicleFuelLogs         VehicleFuelLog[]                 @relation("VehicleFuelLogCreatedBy")
  createdVehicleMaintenance      VehicleMaintenance[]             @relation("VehicleMaintenanceCreatedBy")
  maintenanceNotifications       VehicleMaintenanceNotification[]
  createdDrivers                 Driver[]                         @relation("DriverCreatedBy")
  createdOfficers                Officer[]                        @relation("OfficerCreatedBy")
  createdTripAssignments         TripAssignment[]                 @relation("TripAssignmentCreatedBy")
  createdIntelAssessments        IntelAssessment[]                @relation("IntelAssessmentCreatedBy")
  createdHandovers               HandoverEntry[]                  @relation("HandoverCreatedBy")
  acknowledgedHandovers          HandoverEntry[]                  @relation("HandoverAcknowledgedBy")
  createdContacts                Contact[]                        @relation("ContactCreatedBy")
  createdSops                    Sop[]                            @relation("SopCreatedBy")
  sopAcknowledgements            SopAcknowledgement[]
  sopRevisions                   SopRevision[]                    @relation("SopRevisionChangedBy")
  createdContracts               Contract[]                       @relation("ContractCreatedBy")
  notes                          Note[]                           @relation("NoteOwner")
  createdPersonnel               Personnel[]                      @relation("PersonnelCreatedBy")
  createdTravelers               Traveler[]                       @relation("TravelerCreatedBy")
  personnelRecord                Personnel?                       @relation("PersonnelUser")
  createdMapCategories           MapCategory[]                    @relation("MapCategoryCreatedBy")
  createdMapLayers               MapLayer[]                       @relation("MapLayerCreatedBy")
  createdMapGeofences            MapGeofence[]                    @relation("MapGeofenceCreatedBy")
}

model PersonalTodo {
  id            Int                        @id @default(autoincrement())
  userId        Int
  title         String
  description   String?
  priority      String                     @default("medium")
  status        String                     @default("Backlog")
  startDate     DateTime?
  dueDate       DateTime?
  completed     Boolean                    @default(false)
  completedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   PersonalTodoAttachment[]
  shares        PersonalTodoShare[]
  notifications PersonalTodoNotification[]
  comments      PersonalTodoComment[]
  subtasks      Json?

  @@index([userId, completed, dueDate])
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
}

model PersonalTodoAttachment {
  id        Int          @id @default(autoincrement())
  todoId    Int
  userId    Int
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime     @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoShare {
  id        Int          @id @default(autoincrement())
  todoId    Int
  userId    Int
  createdAt DateTime     @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoNotification {
  id        Int          @id @default(autoincrement())
  userId    Int
  todoId    Int
  type      String
  message   String
  createdAt DateTime     @default(now())
  readAt    DateTime?
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([todoId])
}

model PersonalTodoComment {
  id        Int          @id @default(autoincrement())
  todoId    Int
  userId    Int
  body      String
  createdAt DateTime     @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId, createdAt])
}

model PersonalTodoBoard {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  columns      Json
  columnColors Json?
  taskOrder    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleModules     RoleModule[]
}

/// A module every holder of the role can open. A user's access is the union of
/// these and their own UserModule grants; admins see every module regardless.
model RoleModule {
  id       Int    @id @default(autoincrement())
  roleId   Int
  moduleId Int
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String
  category    String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userModules UserModule[]
  roleModules RoleModule[]

  @@index([category, sortOrder])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model UserModule {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String?
  actorUserId  Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([targetUserId])
}

model Customer {
  id                   Int           @id @default(autoincrement())
  name                 String
  email                String?
  phone                String?
  company              String?
  address              String?
  billingAddress       String?
  // Which business entity this customer belongs to (LADYASKARI | LIONESS | STARLLWART).
  entity               String        @default("LADYASKARI")
  // QuickBooks Online Customer.Id once mirrored there.
  quickbooksCustomerId String?
  // Wave (waveapps.com) Customer id once mirrored there.
  waveCustomerId       String?
  createdById          Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User          @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotes               Quote[]
  invoices             Invoice[]
  trips                Trip[]
  contacts             Contact[]
  travelers            Traveler[]
  deals                Deal[]
  crmActivities        CrmActivity[]

  @@index([createdById, createdAt])
  @@index([name])
  @@index([entity])
}

model Contact {
  id                 Int           @id @default(autoincrement())
  name               String
  role               String?
  category           String        @default("Client")
  email              String?
  phone              String?
  location           String?
  notes              String?
  tags               String[]      @default([])
  customerId         Int?
  photoName          String?
  photoMime          String?
  photoSize          Int?
  photoContent       Bytes?
  // Provenance: "manual" or "google". Google rows carry the People API resource
  // name so a re-sync updates the same row instead of creating a duplicate.
  source             String        @default("manual")
  googleResourceName String?       @unique
  syncedAt           DateTime?
  createdById        Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          User          @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  crmActivities      CrmActivity[]

  @@index([createdById, createdAt])
  @@index([category])
  @@index([name])
  @@index([source])
  @@index([customerId])
}

// A CRM pipeline deal. Stage keys live in lib/crm.ts (lead → onboarding →
// proposal → won → execution → invoiced → closed, plus lost). "Outstanding
// 30+ days" is derived from stage=invoiced + stageChangedAt, not stored.
model Deal {
  id                Int           @id @default(autoincrement())
  title             String
  customerId        Int
  stage             String        @default("lead")
  value             Decimal       @default(0) @db.Decimal(14, 2)
  currency          String        @default("USD")
  quoteId           Int?
  contractId        Int?
  // E-signature tracking for the proposal / NDA: none | sent | signed | declined.
  signatureStatus   String        @default("none")
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  stageChangedAt    DateTime      @default(now())
  createdById       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote             Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contract          Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activities        CrmActivity[]

  @@index([stage, stageChangedAt])
  @@index([customerId])
  @@index([quoteId])
  @@index([contractId])
}

// Communication history entry: call | email | meeting | note.
model CrmActivity {
  id          Int      @id @default(autoincrement())
  customerId  Int
  dealId      Int?
  contactId   Int?
  type        String   @default("note")
  summary     String
  occurredAt  DateTime @default(now())
  createdById Int
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("CrmActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, occurredAt])
  @@index([dealId])
  @@index([contactId])
}

model Quote {
  id             Int                 @id @default(autoincrement())
  reference      String              @unique
  trackingCode   String?             @unique
  customerId     Int
  createdById    Int
  approverId     Int?
  brandProfileId Int?
  subject        String
  status         String              @default("Draft")
  issueDate      DateTime
  expiryDate     DateTime
  currency       String              @default("USD")
  taxRate        Decimal             @default(0) @db.Decimal(6, 4)
  discountType   String              @default("none")
  discountValue  Decimal             @default(0) @db.Decimal(14, 2)
  discountAmount Decimal             @default(0) @db.Decimal(14, 2)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  tax            Decimal             @default(0) @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  notes          String?
  terms          String?
  decisionNote   String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  sentAt         DateTime?
  // Wave (waveapps.com) Estimate id once mirrored there, and the last sync error.
  waveEstimateId String?
  waveSyncError  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      User                @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approver       User?               @relation("QuoteApprover", fields: [approverId], references: [id], onDelete: SetNull)
  brandProfile   BrandProfile?       @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  notifications  QuoteNotification[]
  trip           Trip?               @relation("QuoteSourceTrip")
  invoices       Invoice[]           @relation("QuoteInvoices")
  deals          Deal[]

  @@index([createdById, status])
  @@index([approverId, status])
  @@index([customerId])
  @@index([status, expiryDate])
  @@index([trackingCode])
  @@index([brandProfileId])
}

model QuoteItem {
  id                 Int                 @id @default(autoincrement())
  quoteId            Int
  position           Int
  description        String
  quantity           Decimal             @db.Decimal(12, 2)
  // Number of days the line covers; line subtotal = quantity × days × unitPrice.
  days               Decimal             @default(1) @db.Decimal(12, 2)
  unitPrice          Decimal             @db.Decimal(14, 2)
  taxable            Boolean             @default(true)
  discountType       String              @default("none")
  discountValue      Decimal             @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(14, 2)
  total              Decimal             @db.Decimal(14, 2)
  productId          Int?
  quote              Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  tripItineraryItems TripItineraryItem[] @relation("QuoteItemSourceItinerary")

  @@index([quoteId, position])
  @@index([productId])
}

model QuoteNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  quoteId   Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quoteId])
}

/// A product or service. The standardized services (prisma/data/standard-services.json)
/// follow the Standardized Naming Master: `name` is the Standardized Service Name
/// and `sku` the Service Code, unique and never reused.
model Product {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  sku              String?
  defaultUnitPrice Decimal       @default(0) @db.Decimal(14, 2)
  currency         String        @default("USD")
  taxable          Boolean       @default(true)
  archived         Boolean       @default(false)
  quickbooksName   String?
  /// Airport Services, Transfers, Vehicle Hire, Personnel, …
  category         String?
  subCategory      String?
  /// Asset / Personnel Class: Sedan, SUV, Close Protection Officer, …
  serviceClass     String?
  /// Standard / Executive / Luxury, or Level 1-3 for personnel.
  tier             String?
  country          String?
  location         String?
  airportCode      String?
  coverageScope    String?
  vehicleExamples  String?
  unitOfMeasure    String?
  terms            String?
  /// Notes / open items.
  notes            String?
  createdById      Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        User          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quoteItems       QuoteItem[]
  invoiceItems     InvoiceItem[]

  @@index([archived, name])
  @@index([createdById])
  @@index([sku])
}

/// Each version of the standardized service catalog the seed has loaded. A
/// version loads once, so a service deleted afterwards stays deleted.
model ServiceCatalogImport {
  version   String   @id
  created   Int
  createdAt DateTime @default(now())
}

model QuoteTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  taxRate       Decimal  @default(0) @db.Decimal(6, 4)
  currency      String   @default("USD")
  terms         String?
  notes         String?
  discountType  String   @default("none")
  discountValue Decimal  @default(0) @db.Decimal(14, 2)
  items         Json     @default("[]")
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation("QuoteTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, name])
}

model OrganizationSettings {
  id                     Int      @id @default(1)
  companyName            String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  region                 String?
  postalCode             String?
  country                String?
  email                  String?
  phone                  String?
  website                String?
  defaultCurrency        String   @default("USD")
  defaultTaxRate         Decimal  @default(0) @db.Decimal(6, 4)
  taxLabel               String   @default("Tax")
  /// Users told (in the app and by email) when a trip log entry is escalated.
  escalationRecipientIds Int[]    @default([])
  logo                   Bytes?
  logoMimeType           String?
  updatedById            Int?
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model QuoteSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model BrandProfile {
  id                 Int       @id @default(autoincrement())
  name               String
  companyName        String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  region             String?
  postalCode         String?
  country            String?
  email              String?
  phone              String?
  website            String?
  logo               Bytes?
  logoMimeType       String?
  primaryColor       String    @default("#03458f")
  isDefault          Boolean   @default(false)
  archived           Boolean   @default(false)
  // Which accounting system invoices/quotes on this brand sync to.
  // 'none' | 'quickbooks' | 'wave'
  accountingProvider String    @default("none")
  createdById        Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          User      @relation("BrandProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotes             Quote[]
  invoices           Invoice[]

  @@index([archived, name])
  @@index([isDefault])
}

model Invoice {
  id                  Int                   @id @default(autoincrement())
  number              String                @unique
  customerId          Int
  createdById         Int
  approverId          Int?
  brandProfileId      Int?
  sourceQuoteId       Int?
  // Draft | Pending Approval | Approved | Declined | Sent | Partial | Paid | Void
  status              String                @default("Draft")
  decisionNote        String?
  submittedAt         DateTime?
  decidedAt           DateTime?
  issueDate           DateTime
  dueDate             DateTime
  currency            String                @default("USD")
  taxRate             Decimal               @default(0) @db.Decimal(6, 4)
  discountType        String                @default("none")
  discountValue       Decimal               @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(14, 2)
  subtotal            Decimal               @default(0) @db.Decimal(14, 2)
  tax                 Decimal               @default(0) @db.Decimal(14, 2)
  total               Decimal               @default(0) @db.Decimal(14, 2)
  amountPaid          Decimal               @default(0) @db.Decimal(14, 2)
  notes               String?
  terms               String?
  sentAt              DateTime?
  paidAt              DateTime?
  // QuickBooks Online Invoice.Id once mirrored there.
  quickbooksInvoiceId String?
  // Wave (waveapps.com) Invoice id once mirrored there, and the last sync error.
  waveInvoiceId       String?
  waveSyncError       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           User                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approver            User?                 @relation("InvoiceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  brandProfile        BrandProfile?         @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  sourceQuote         Quote?                @relation("QuoteInvoices", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  payments            InvoicePayment[]
  notifications       InvoiceNotification[]

  @@index([customerId])
  @@index([status, dueDate])
  @@index([createdById])
  @@index([brandProfileId])
  @@index([number])
  @@index([sourceQuoteId])
}

model InvoiceItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  position       Int
  description    String
  quantity       Decimal  @db.Decimal(12, 2)
  unitPrice      Decimal  @db.Decimal(14, 2)
  taxable        Boolean  @default(true)
  discountType   String   @default("none")
  discountValue  Decimal  @default(0) @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @db.Decimal(14, 2)
  productId      Int?
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@index([productId])
}

model InvoicePayment {
  id                  Int      @id @default(autoincrement())
  invoiceId           Int
  amount              Decimal  @db.Decimal(14, 2)
  method              String   @default("Bank transfer")
  reference           String?
  note                String?
  paidAt              DateTime
  // QuickBooks Online Payment.Id when synced; sync error message when not.
  quickbooksPaymentId String?
  quickbooksSyncError String?
  createdById         Int
  createdAt           DateTime @default(now())
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy           User     @relation("InvoicePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId, paidAt])
}

model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model InvoiceNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  invoiceId Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([invoiceId])
}

// Single-company QuickBooks Online OAuth connection (latest row wins).
model QuickBooksConnection {
  id                   Int      @id @default(autoincrement())
  realmId              String   @unique
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  connectedById        Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  connectedBy          User     @relation("QuickBooksConnectedBy", fields: [connectedById], references: [id], onDelete: Restrict)
}

model WaveConnection {
  id                   Int      @id @default(autoincrement())
  businessId           String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  connectedById        Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  connectedBy          User     @relation("WaveConnectedBy", fields: [connectedById], references: [id], onDelete: Restrict)
}

/// One linked messaging account, owned by exactly one platform user.
///
/// Each user links their own WhatsApp / Telegram / Signal, so a thread is only
/// ever visible to the person whose account received it — there is no admin
/// override for reading someone else's conversations.
model MessagingAccount {
  id       Int    @id @default(autoincrement())
  userId   Int
  /// 'whatsapp' | 'telegram' | 'signal'
  provider String

  /// Provider-side identifier for this account:
  ///   whatsapp -> the `wacli accounts` name (isolated store directory)
  ///   signal   -> the linked E.164 number
  ///   telegram -> the account's phone number, for display
  handle String

  /// Human-readable name shown in the console header (WhatsApp: the linked
  /// phone number, e.g. "+254712345678").
  label String?

  /// Telegram only: the GramJS StringSession. A full account credential —
  /// never returned to the browser. WhatsApp and Signal keep their own
  /// credentials in their CLI store directories instead.
  session String?

  /// High-water mark for incremental provider backfill (wacli `messages list
  /// --after`, Telegram message ids). Null until the first sync completes.
  syncedUpTo DateTime?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation("MessagingAccountOwner", fields: [userId], references: [id], onDelete: Cascade)
  chats     MessagingChat[]
  messages  MessagingMessage[]

  /// WhatsApp allows several accounts per user, one per wacli store; Telegram
  /// and Signal keep one each, which lib/messaging-accounts.ts enforces.
  @@unique([userId, provider, handle])
  @@index([provider])
}

/// A conversation mirrored from a linked messaging account.
///
/// The UI reads chats and messages from Postgres, never from the provider, so
/// opening a module is a single indexed query instead of a CLI round-trip.
model MessagingChat {
  id            Int              @id @default(autoincrement())
  accountId     Int
  /// Provider-side chat id (JID, phone number, `group:<id>`, Telegram peer id).
  chatId        String
  kind          String           @default("dm")
  name          String
  lastMessageAt DateTime
  unreadCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  account       MessagingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, chatId])
  @@index([accountId, lastMessageAt])
}

/// One mirrored message. Media bytes are never stored here — only the provider
/// reference needed to stream them on demand through /api/<provider>/media.
model MessagingMessage {
  id         Int      @id @default(autoincrement())
  accountId  Int
  chatId     String
  /// Provider-side message id; unique per chat so re-ingest is idempotent.
  messageId  String
  senderName String
  fromMe     Boolean  @default(false)
  text       String   @default("")
  at         DateTime

  mediaKind String?
  mediaRef  String?
  mediaMime String?
  mediaName String?
  mediaSize Int?

  createdAt DateTime         @default(now())
  account   MessagingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, chatId, messageId])
  @@index([accountId, chatId, at])
  @@index([accountId, at])
}

model Trip {
  id            Int                 @id @default(autoincrement())
  reference     String              @unique
  trackingCode  String              @unique
  customerId    Int
  sourceQuoteId Int?                @unique
  createdById   Int
  ownerId       Int?
  title         String
  description   String?
  status        String              @default("Draft")
  /// One of the Standardized Naming Master's markets; its code is in the reference.
  country       String?
  startDate     DateTime?
  endDate       DateTime?
  currency      String              @default("USD")
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceQuote   Quote?              @relation("QuoteSourceTrip", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  owner         User?               @relation("TripOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items         TripItineraryItem[]
  assignments   TripAssignment[]
  days          TripDay[]
  travelers     TripTraveler[]
  logEntries    TripLogEntry[]
  closeout      TripCloseout?
  shareLink     TripShareLink?

  @@index([createdById, status])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([trackingCode])
}

model TripItineraryItem {
  id                    Int                             @id @default(autoincrement())
  tripId                Int
  dayId                 Int?
  position              Int
  /// Legacy 5-value type. Retained for one release as a rollback path; new
  /// code reads `category`.
  itemType              String                          @default("activity")
  /// flight | activity | lodging | transportation | tour | booking | information
  category              String                          @default("activity")
  description           String
  subtitle              String?
  /// Long-form description shown under the title.
  body                  String?
  /// ARRIVAL / DEPARTURE / CHECK-IN / CHECK-OUT / PICK-UP / DROP-OFF, or free text.
  timeLabel             String?
  /// Airline, hotel chain, rental company, tour operator — whoever supplies it.
  providerName          String?
  bookingUrl            String?
  phone                 String?
  placeName             String?
  address               String?
  /// Category-specific fields. Shape is enforced by a zod discriminated union
  /// at the API edge rather than by 40 sparse columns nothing else queries.
  details               Json?
  quantity              Decimal                         @db.Decimal(12, 2)
  unitPrice             Decimal?                        @db.Decimal(14, 2)
  completedAt           DateTime?
  sourceQuoteItemId     Int?
  scheduledAt           DateTime?
  endsAt                DateTime?
  durationMinutes       Int?
  reminderMinutesBefore Int?
  reminderAt            DateTime?
  reminderSentAt        DateTime?
  imageUrl              String?
  confirmationCode      String?
  /// Who and what runs this movement, picked from Task Assignment's registers.
  /// SetNull: retiring a car or a person never rewrites the itinerary's history.
  driverId              Int?
  officerId             Int?
  vehicleId             Int?
  trip                  Trip                            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day                   TripDay?                        @relation(fields: [dayId], references: [id], onDelete: SetNull)
  driver                Driver?                         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  officer               Officer?                        @relation(fields: [officerId], references: [id], onDelete: SetNull)
  vehicle               Vehicle?                        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sourceQuoteItem       QuoteItem?                      @relation("QuoteItemSourceItinerary", fields: [sourceQuoteItemId], references: [id], onDelete: SetNull)
  notifications         TripItineraryItemNotification[]
  attachments           TripItemAttachment[]
  travelers             TripItemTraveler[]

  @@index([dayId, position])
  @@index([tripId, category])
  @@index([tripId, position])
  @@index([tripId, scheduledAt])
  @@index([reminderAt, reminderSentAt])
  @@index([sourceQuoteItemId])
  @@index([driverId])
  @@index([officerId])
  @@index([vehicleId])
}

/// Which of the trip's travellers an event is for. None means the whole party.
/// Points at the trip's traveller link, not the Traveler, so an event can only
/// name someone on the trip and loses them if they leave it.
model TripItemTraveler {
  id             Int               @id @default(autoincrement())
  itemId         Int
  tripTravelerId Int
  item           TripItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tripTraveler   TripTraveler      @relation(fields: [tripTravelerId], references: [id], onDelete: Cascade)

  @@unique([itemId, tripTravelerId])
  @@index([tripTravelerId])
}

/// Photos and documents on an itinerary event.
model TripItemAttachment {
  id           Int               @id @default(autoincrement())
  itemId       Int
  filename     String
  mimeType     String
  size         Int
  content      Bytes
  /// Small WebP preview for images, so cards never load the full upload.
  thumbnail    Bytes?
  uploadedById Int?
  createdAt    DateTime          @default(now())
  item         TripItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy   User?             @relation("TripItemAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([uploadedById])
}

model TripDay {
  id        Int                 @id @default(autoincrement())
  tripId    Int
  /// "YYYY-MM-DD", or null for a trip whose dates are still TBD.
  /// Deliberately a string, not DateTime: Prisma hands a date column back as
  /// UTC midnight, which reads as the previous day west of Greenwich. A date
  /// key round-trips unchanged and sorts lexicographically. Same convention as
  /// ScheduleShift.date.
  dateKey   String?
  /// Dense 1..N. The only ordering key, and the "Day 3" label when undated.
  dayNumber Int
  title     String?
  summary   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  trip      Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     TripItineraryItem[]

  @@index([tripId, dayNumber])
  @@index([tripId, dateKey])
}

model TripItineraryItemNotification {
  id        Int               @id @default(autoincrement())
  userId    Int
  itemId    Int
  type      String
  message   String
  createdAt DateTime          @default(now())
  readAt    DateTime?
  item      TripItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([itemId])
}

model TripSequence {
  year       Int @id
  lastNumber Int @default(0)
}

/// One line in a trip's operations log: what was reported, by whom, and the
/// action taken. Imported from FileMaker's task log and added to from the trip page.
model TripLogEntry {
  id             Int                   @id @default(autoincrement())
  tripId         Int
  loggedAt       DateTime
  detail         String
  /// Who reported it (FileMaker "detail received by"), free text.
  receivedFrom   String?
  actionItem     String?
  /// Duty controller on shift, free text: FileMaker names have no user account.
  dutyController String?
  comments       String?
  escalated      Boolean               @default(false)
  createdById    Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  trip           Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("TripLogEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications  TripLogNotification[]

  @@index([tripId, loggedAt])
  @@index([escalated])
}

/// Someone on the escalation list was told a trip log entry was escalated.
model TripLogNotification {
  id        Int          @id @default(autoincrement())
  userId    Int
  entryId   Int
  type      String       @default("trip.escalated")
  message   String
  createdAt DateTime     @default(now())
  readAt    DateTime?
  entry     TripLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User         @relation("TripLogNotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entryId])
}

/// Verification of a completed trip (lib/trip-closeout.ts). Stays editable after
/// the trip is closed out; closedAt is null while the close-out is still open.
model TripCloseout {
  id             Int       @id @default(autoincrement())
  tripId         Int       @unique
  /// The checks confirmed so far: keys of CLOSEOUT_CHECKS in lib/trip-closeout-checks.ts.
  checks         String[]  @default([])
  summary        String?
  issues         String?
  clientFeedback String?
  closedAt       DateTime?
  closedById     Int?
  updatedById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  closedBy       User?     @relation("TripCloseoutClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  updatedBy      User?     @relation("TripCloseoutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([closedAt])
}

/// The client's read-only link to a trip's itinerary (lib/trip-share.ts). One
/// per trip: a new link replaces the old token, and deleting the row revokes it.
model TripShareLink {
  id                 Int       @id @default(autoincrement())
  tripId             Int       @unique
  /// Random and URL-safe. It is the whole credential, so it never goes in logs or audit metadata.
  token              String    @unique
  /// Crew names and phones, vehicles and item notes (which often name security staff).
  includeCrew        Boolean   @default(false)
  /// Each stop's photos and documents (tickets, vouchers), served through the link.
  includeAttachments Boolean   @default(true)
  createdById        Int?
  viewCount          Int       @default(0)
  lastViewedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  trip               Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy          User?     @relation("TripShareLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

// --- Task assignment: fleet & protection resources allocated to trips ---

model Vehicle {
  id             Int                  @id @default(autoincrement())
  registration   String               @unique
  make           String?
  model          String?
  type           String               @default("Sedan")
  status         String               @default("Available")
  capacity       Int?
  notes          String?
  photoName      String?
  photoMime      String?
  photoSize      Int?
  photoContent   Bytes?
  createdById    Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      User                 @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignments    TripAssignment[]
  itineraryItems TripItineraryItem[]
  fuelLogs       VehicleFuelLog[]
  maintenance    VehicleMaintenance[]

  @@index([status])
  @@index([registration])
}

/// A fill-up for a fleet vehicle (lib/fleet-server.ts). History goes with the
/// vehicle; the author is only a label and survives as null if they are deleted.
model VehicleFuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  filledAt    DateTime
  litres      Decimal  @db.Decimal(10, 2)
  /// Total paid for the fill-up.
  cost        Decimal? @db.Decimal(14, 2)
  currency    String   @default("USD")
  odometerKm  Int?
  fuelType    String   @default("Petrol")
  /// The tank was filled to the top, so the distance since the last fill-up gives the consumption.
  fullTank    Boolean  @default(true)
  station     String?
  filledBy    String?
  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("VehicleFuelLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId, filledAt])
  @@index([filledAt])
  @@index([createdById])
}

/// A service, repair, or inspection for a fleet vehicle (lib/fleet-server.ts).
model VehicleMaintenance {
  id            Int                              @id @default(autoincrement())
  vehicleId     Int
  /// Scheduled (planned upkeep: services, inspections) | Unscheduled (breakdowns, accidents, faults)
  kind          String                           @default("Scheduled")
  category      String                           @default("Service")
  title         String
  /// Planned | In progress | Completed | Cancelled
  status        String                           @default("Planned")
  scheduledFor  DateTime?
  completedAt   DateTime?
  odometerKm    Int?
  cost          Decimal?                         @db.Decimal(14, 2)
  currency      String                           @default("USD")
  provider      String?
  nextDueAt     DateTime?
  nextDueKm     Int?
  /// Days before the planned or next-due date to remind Car Maintenance users; null for none (lib/fleet-reminders.ts).
  reminderDays  Int?
  notes         String?
  createdById   Int?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  vehicle       Vehicle                          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy     User?                            @relation("VehicleMaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications VehicleMaintenanceNotification[]

  @@index([vehicleId, status])
  @@index([status, scheduledFor])
  @@index([createdById])
}

/// A maintenance reminder in one user's bell (lib/fleet-reminders.ts). The key
/// names the reminder and its due date or km, so each one reaches each user once
/// and a rescheduled job reminds again.
model VehicleMaintenanceNotification {
  id            Int                @id @default(autoincrement())
  userId        Int
  maintenanceId Int
  reminderKey   String
  type          String
  message       String
  createdAt     DateTime           @default(now())
  readAt        DateTime?
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenance   VehicleMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderKey])
  @@index([userId, createdAt])
  @@index([maintenanceId])
}

model Driver {
  id             Int                 @id @default(autoincrement())
  name           String
  /// Master personnel record this resource mirrors. SetNull, never Cascade:
  /// TripAssignment history points here and must survive a personnel delete.
  personnelId    Int?                @unique
  /// Set when the person loses the Driver role. The row is KEPT so historical
  /// TripAssignment.driverId never dangles; retired rows are hidden from pickers.
  retiredAt      DateTime?
  phone          String?
  licenseNumber  String?
  status         String              @default("Available")
  notes          String?
  photoName      String?
  photoMime      String?
  photoSize      Int?
  photoContent   Bytes?
  createdById    Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User                @relation("DriverCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  personnel      Personnel?          @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  assignments    TripAssignment[]
  itineraryItems TripItineraryItem[]

  @@index([status])
  @@index([name])
}

model Officer {
  id             Int                 @id @default(autoincrement())
  name           String
  /// Master personnel record this resource mirrors. See Driver.personnelId.
  personnelId    Int?                @unique
  /// See Driver.retiredAt.
  retiredAt      DateTime?
  callSign       String?
  grade          String              @default("CPO")
  phone          String?
  status         String              @default("Available")
  notes          String?
  photoName      String?
  photoMime      String?
  photoSize      Int?
  photoContent   Bytes?
  createdById    Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User                @relation("OfficerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  personnel      Personnel?          @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  assignments    TripAssignment[]
  itineraryItems TripItineraryItem[]

  @@index([status])
  @@index([name])
}

model TripAssignment {
  id          Int      @id @default(autoincrement())
  tripId      Int
  vehicleId   Int?
  driverId    Int?
  officerId   Int?
  status      String   @default("Planned")
  notes       String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver      Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  officer     Officer? @relation(fields: [officerId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("TripAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([officerId])
  @@index([status])
}

model IntelAssessment {
  id               Int      @id @default(autoincrement())
  location         String
  formattedAddress String?
  country          String?
  latitude         Float?
  longitude        Float?
  context          String?
  title            String
  riskLevel        String   @default("Moderate")
  summary          String
  sections         Json
  recommendations  Json
  sources          Json
  mapImage         Bytes?
  mapImageMime     String?
  streetImage      Bytes?
  streetImageMime  String?
  model            String?
  status           String   @default("Complete")
  createdById      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User     @relation("IntelAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([riskLevel])
  @@index([createdAt])
}

// Shift handover log — an outgoing shift records the situation; the incoming
// shift acknowledges receipt. One row per handover.
model HandoverEntry {
  id               Int       @id @default(autoincrement())
  shiftDate        DateTime
  shiftPeriod      String    @default("Day")
  post             String?
  status           String    @default("Normal")
  summary          String
  incidents        String?
  watchItems       String?
  createdById      Int
  acknowledgedById Int?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        User      @relation("HandoverCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acknowledgedBy   User?     @relation("HandoverAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([shiftDate])
  @@index([status])
  @@index([acknowledgedById])
}

model TrackingSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}

/// Last good exchange-rate table per base currency (see lib/exchange-rates-server.ts).
/// Lets reports keep converting after a restart or while the rates service is down.
model ExchangeRateSnapshot {
  base      String   @id
  /// Currency code → units per 1 `base`.
  rates     Json
  /// When the provider published these rates.
  asOf      DateTime
  fetchedAt DateTime @updatedAt
}

model Conversation {
  id          Int                  @id @default(autoincrement())
  type        String               @default("direct")
  title       String?
  createdById Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int                   @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  createdAt      DateTime              @default(now())
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  notifications  MessageNotification[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageNotification {
  id             Int       @id @default(autoincrement())
  userId         Int
  messageId      Int
  conversationId Int
  type           String
  message        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageRef     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, conversationId])
  @@index([messageId])
}

model Feedback {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  category    String            @default("Improvement")
  status      String            @default("New")
  authorId    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User              @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  upvotes     FeedbackUpvote[]
  comments    FeedbackComment[]

  @@index([status, createdAt])
  @@index([category, createdAt])
}

model FeedbackUpvote {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  userId     Int
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([userId])
}

model FeedbackComment {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  userId     Int
  body       String
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

model DriverLicense {
  id              Int        @id @default(autoincrement())
  /// Owning personnel record. Nullable: legacy rows and rows whose driverName
  /// did not uniquely match a person stay unlinked rather than being guessed.
  personnelId     Int?
  driverName      String
  licenseNumber   String
  category        String     @default("Class A")
  expiryDate      DateTime
  lastVerified    DateTime?
  notes           String?
  documentName    String?
  documentMime    String?
  documentSize    Int?
  documentContent Bytes?
  createdById     Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdBy       User       @relation("DriverLicenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  personnel       Personnel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)

  @@index([expiryDate])
  @@index([driverName])
  @@index([personnelId])
}

model StoredFile {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?
  tags          String[]           @default([])
  mimeType      String
  size          Int
  content       Bytes
  uploadedById  Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  uploadedBy    User               @relation("StoredFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  shares        StoredFileShare[]
  notifications FileNotification[]

  @@index([createdAt])
  @@index([uploadedById])
}

model StoredFileShare {
  id        Int        @id @default(autoincrement())
  fileId    Int
  userId    Int
  createdAt DateTime   @default(now())
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([userId])
}

model FileNotification {
  id        Int        @id @default(autoincrement())
  userId    Int
  fileId    Int
  type      String
  message   String
  createdAt DateTime   @default(now())
  readAt    DateTime?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileId])
}

model CalendarEvent {
  id                    Int                         @id @default(autoincrement())
  userId                Int
  title                 String
  description           String?
  location              String?
  tag                   String?
  startsAt              DateTime
  endsAt                DateTime?
  allDay                Boolean                     @default(false)
  reminderMinutesBefore Int?
  reminderAt            DateTime?
  reminderSentAt        DateTime?
  googleEventId         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications         CalendarEventNotification[]

  @@index([userId, startsAt])
  @@index([reminderAt, reminderSentAt])
}

model CalendarEventNotification {
  id        Int           @id @default(autoincrement())
  userId    Int
  eventId   Int
  type      String
  message   String
  createdAt DateTime      @default(now())
  readAt    DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventId])
}

/// A recurring shift pattern — "Morning, 9am–5pm, Mon–Fri".
///
/// Templates are what managers maintain; individual ScheduleShift rows are what
/// actually lands on the board. Keeping them separate means editing a pattern
/// never silently rewrites history that has already been worked.
model ShiftTemplate {
  id        String  @id @default(cuid())
  name      String
  /// 24h "HH:MM". Stored as text because a shift has no date of its own, and an
  /// overnight shift legitimately ends before it starts (22:00 → 06:00).
  startTime String
  endTime   String
  /// ISO weekdays this pattern runs on: 1 = Monday … 7 = Sunday.
  weekdays  Int[]   @default([])
  /// Palette key, not a raw colour — the UI owns the actual values.
  colour    String  @default("blue")
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("ShiftTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  members ShiftTemplateMember[]
  teams   ShiftTemplateTeam[]
  shifts  ScheduleShift[]

  @@index([active, sortOrder])
}

/// A named group of people that can be rostered as a unit.
model Team {
  id     String @id @default(cuid())
  name   String @unique
  colour String @default("emerald")

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  members        TeamMember[]
  shiftTemplates ShiftTemplateTeam[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId Int
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// One person attached to a shift pattern.
model ShiftTemplateMember {
  id         String @id @default(cuid())
  templateId String
  userId     Int
  /// Contracted hours for this person on this shift; the pattern's own span is
  /// the default, but part-timers differ.
  hours      Int?

  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User          @relation("ShiftTemplateMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
}

/// A whole team attached to a shift pattern.
model ShiftTemplateTeam {
  id         String @id @default(cuid())
  templateId String
  teamId     String
  hours      Int?

  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([templateId, teamId])
}

/// Time off. Anyone may request; only a manager approves.
model LeaveRequest {
  id        String  @id @default(cuid())
  userId    Int
  /// annual | sick | casual | unpaid
  type      String  @default("annual")
  /// Inclusive 'YYYY-MM-DD' bounds, matching ScheduleShift.date.
  startDate String
  endDate   String
  /// pending | approved | declined
  status    String  @default("pending")
  note      String?

  decidedById Int?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("LeaveRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([startDate, endDate])
  @@index([userId, startDate])
}

/// A non-working day shown across the whole calendar.
model PublicHoliday {
  id   String @id @default(cuid())
  /// 'YYYY-MM-DD'
  date String @unique
  name String

  createdById Int?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("PublicHolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model ScheduleShift {
  id             Int            @id @default(autoincrement())
  employeeId     Int
  /// Set when the shift came from a pattern; null for one-off shifts.
  templateId     String?
  date           String // 'YYYY-MM-DD'
  type           String
  startTime      String?
  endTime        String?
  timeLabel      String?
  statusLabel    String?
  role           String?
  location       String?
  breakMinutes   Int?
  note           String?
  tasksCompleted Int?
  totalTasks     Int?
  publishedAt    DateTime?
  createdById    Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  employee       User           @relation("ScheduleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  template       ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // No longer @@unique([employeeId, date]) — an employee can have multiple
  // shifts on the same day (split shifts, overlapping coverage).
  @@index([employeeId, date])
  @@index([date])
}

// Radio (Zello) channel traffic — persisted so switching channels keeps history.
model ZelloActivity {
  id           Int      @id @default(autoincrement())
  network      String   @default("")
  channel      String
  kind         String // 'voice' | 'text'
  fromName     String // Zello username / display name of the speaker or sender
  direction    String   @default("in") // 'in' (received) | 'out' (this console)
  text         String? // text message body
  transcript   String? // verbatim voice transcript
  translation  String? // English translation
  language     String?
  durationMs   Int?
  hasAudio     Boolean  @default(false)
  audio        Bytes? // 16 kHz mono WAV of the transmission, for replay (security archive)
  at           DateTime // when it occurred on the channel
  createdAt    DateTime @default(now())
  recordedById Int?
  recordedBy   User?    @relation("ZelloActivityRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([network, channel, at])
}

// Latest known position per Zello device — drives the live tracking map.
model ZelloDeviceLocation {
  id        Int      @id @default(autoincrement())
  network   String   @default("")
  channel   String
  device    String // Zello username
  latitude  Float
  longitude Float
  accuracy  Float?
  address   String?
  at        DateTime // when the device reported this position
  updatedAt DateTime @updatedAt

  @@unique([network, channel, device])
  @@index([network, channel])
}

// WhatsApp Cloud API message log — one row per inbound/outbound message.
model WhatsAppMessage {
  id           Int      @id @default(autoincrement())
  waMessageId  String?  @unique // Graph API "wamid." — unique per message, dedupes webhook retries
  direction    String // 'in' (received) | 'out' (sent from this console)
  contact      String // the other party's phone number (E.164, no +)
  contactName  String? // WhatsApp profile name, when the webhook provides it
  type         String   @default("text") // text | template | image | ...
  body         String? // message text (or template name for templates)
  status       String   @default("sent") // queued | sent | delivered | read | failed | received
  errorText    String? // populated when status = failed
  at           DateTime // when the message was sent/received
  createdAt    DateTime @default(now())
  recordedById Int?
  recordedBy   User?    @relation("WhatsAppMessageRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([contact, at])
  @@index([at])
}

// Standard Operating Procedure — a controlled compliance document.
model Sop {
  id               Int                  @id @default(autoincrement())
  code             String               @unique // e.g. OPS-SAF-01
  title            String
  category         String               @default("Operations")
  status           String               @default("Draft") // Draft | Review | Active | Archived
  version          String               @default("v1.0")
  ownerName        String? // accountable owner (free text)
  description      String?
  steps            String[]             @default([]) // numbered procedure steps
  effectiveDate    DateTime?
  reviewDate       DateTime? // next review due
  createdById      Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        User                 @relation("SopCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acknowledgements SopAcknowledgement[]
  revisions        SopRevision[]

  @@index([status])
  @@index([category])
  @@index([reviewDate])
}

// A user's confirmation that they have read & understood a specific SOP version.
model SopAcknowledgement {
  id             Int      @id @default(autoincrement())
  sopId          Int
  userId         Int
  version        String // the version that was acknowledged
  acknowledgedAt DateTime @default(now())
  sop            Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sopId, userId, version])
  @@index([sopId, version])
  @@index([userId])
}

// An audit-trail entry recording a change to an SOP (version bump / edit summary).
model SopRevision {
  id          Int      @id @default(autoincrement())
  sopId       Int
  version     String
  summary     String
  changedById Int
  createdAt   DateTime @default(now())
  sop         Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("SopRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([sopId, createdAt])
}

// A workforce / HR record. Standalone, with an optional link to a login (User) account.
model Personnel {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  role           String? // job title
  department     String          @default("Operations")
  status         String          @default("Active") // Active | On Leave | Remote | Terminated
  location       String?
  manager        String? // manager name (free text)
  joinDate       DateTime?
  skills         String[]        @default([])
  /// Operational roles this person can be assigned in. A person may hold
  /// several, e.g. ["CPO", "Driver"]. See PERSONNEL_ROLES in lib/personnel.ts.
  roles          String[]        @default([])
  /// How this person is engaged: Employee | Vendor | Consultant | Contractor.
  engagement     String          @default("Employee")
  /// Vendor/consultancy that supplied them, when engagement is not Employee.
  supplierName   String?
  /// Radio call sign — CPOs.
  callSign       String?
  /// CPO | Team Leader | Detail Leader — CPOs.
  grade          String?
  notes          String?
  userId         Int?            @unique // optional one-to-one link to a login account
  photoName      String?
  photoMime      String?
  photoSize      Int?
  photoContent   Bytes?
  createdById    Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      User            @relation("PersonnelCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  user           User?           @relation("PersonnelUser", fields: [userId], references: [id], onDelete: SetNull)
  licenses       DriverLicense[]
  driverProfile  Driver?
  officerProfile Officer?

  @@index([department])
  @@index([status])
  @@index([name])
}

// A personal, user-scoped quick note (sticky-board style).
/// A person we protect (a principal / protectee), as opposed to Personnel, who
/// are the people we assign to work. Carries sensitive PII -- passport, date of
/// birth, medical -- which is why it sits behind its own `travelers` module grant.
model Traveler {
  id                    Int            @id @default(autoincrement())
  name                  String
  /// Client account this traveller belongs to.
  customerId            Int?
  email                 String?
  phone                 String?
  nationality           String?
  dateOfBirth           DateTime?
  passportNumber        String?
  passportExpiry        DateTime?
  status                String         @default("Active")
  riskLevel             String         @default("Standard")
  dietaryNotes          String?
  medicalNotes          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  photoName             String?
  photoMime             String?
  photoSize             Int?
  photoContent          Bytes?
  createdById           Int
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy             User           @relation("TravelerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  trips                 TripTraveler[]

  @@index([customerId])
  @@index([name])
  @@index([status])
  @@index([passportExpiry])
}

/// Join between a trip and the travellers on it.
model TripTraveler {
  id         Int                @id @default(autoincrement())
  tripId     Int
  travelerId Int
  /// The lead protectee on this trip, when there is more than one.
  isPrimary  Boolean            @default(false)
  notes      String?
  createdAt  DateTime           @default(now())
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  traveler   Traveler           @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  /// The events they're on (see TripItemTraveler).
  items      TripItemTraveler[]

  @@unique([tripId, travelerId])
  @@index([travelerId])
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String   @default("")
  category  String   @default("Work") // Personal | Work | Ideas
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("NoteOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinned, updatedAt])
}

// A tracked agreement/contract with a renewal window (consultants, vendors, retainers).
model Contract {
  id               Int       @id @default(autoincrement())
  reference        String    @unique // e.g. CTR-9901
  counterpartyName String // consultant / vendor / supplier
  email            String?
  department       String?
  type             String    @default("Fixed Term") // Fixed Term | Retainer | Project Based
  status           String    @default("Active") // Active | In Renewal | Renewed | Cancelled
  startDate        DateTime
  endDate          DateTime
  value            Int? // contract value in whole currency units
  currency         String    @default("USD")
  lastRenewalDate  DateTime?
  notes            String?
  documentName     String?
  documentMime     String?
  documentSize     Int?
  documentContent  Bytes?
  createdById      Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        User      @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  deals            Deal[]

  @@index([endDate])
  @@index([status])
  @@index([counterpartyName])
}

// Admin-tunable upload size limits in whole megabytes. Single row (id = 1);
// defaults mirror the previously hardcoded per-route limits.
model UploadLimitSettings {
  id          Int      @id @default(1)
  fileMb      Int      @default(25)
  photoMb     Int      @default(8)
  documentMb  Int      @default(10)
  audioMb     Int      @default(12)
  logoMb      Int      @default(1)
  updatedById Int?
  updatedAt   DateTime @updatedAt
}

/// One Gemini API call: what it cost, for the AI budget (Admin → Settings → AI usage).
model AiUsage {
  id             Int      @id @default(autoincrement())
  at             DateTime @default(now())
  /// 'chatbot' | 'web_search' | 'intel' | 'radio'
  feature        String
  /// The model that actually answered (Gemini reports it; aliases resolve to a version).
  model          String
  userId         Int?
  inputTokens    Int      @default(0)
  /// Of the input, tokens served from Gemini's cache (billed at the cached rate).
  cachedTokens   Int      @default(0)
  /// Of the input, audio tokens (billed at the audio rate).
  audioTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  thinkingTokens Int      @default(0)
  /// Grounded in Google Search (billed per request beyond the free monthly allowance).
  grounded       Boolean  @default(false)
  /// Estimated from Google's published prices.
  costUsd        Float    @default(0)

  @@index([at])
  @@index([feature, at])
  @@index([userId, at])
}

/// Limits on AI spending (one row, id = 1), edited in Admin → Settings → AI usage.
model AiSettings {
  id                        Int     @id @default(1)
  /// Master switch for every AI feature.
  enabled                   Boolean @default(true)
  dailyBudgetUsd            Float   @default(2)
  monthlyBudgetUsd          Float   @default(30)
  chatMessagesPerUserPerDay Int     @default(60)
  /// Across everyone: keeps grounded search inside Google's free monthly allowance.
  webSearchesPerDay         Int     @default(150)
  intelReportsPerUserPerDay Int     @default(10)
  radioTranscription        Boolean @default(true)
  /// Emailed at 80% and 100% of the monthly budget (comma-separated).
  alertEmails               String  @default("")
  /// "2026-10:80" — the last budget alert sent, so each is sent once a month.
  lastAlert                 String?

  updatedById Int?
  updatedAt   DateTime @updatedAt
}

/// Google Drive backups (one row, id = 1), edited in Admin → Settings → Backups.
model BackupSettings {
  id      Int     @id @default(1)
  enabled Boolean @default(false)

  /// Service account key (JSON). A credential: never returned to the browser.
  serviceAccountJson String?
  /// Shared Drive the backups live in, and the folder inside it they go to.
  driveId            String?
  driveName          String?
  folderId           String?

  /// Daily run time, "HH:MM" in `timezone`.
  scheduleTime String @default("02:00")
  timezone     String @default("Africa/Nairobi")

  /// Snapshots kept: the newest per day, the first per week, the first per month.
  keepDaily   Int @default(14)
  keepWeekly  Int @default(8)
  keepMonthly Int @default(12)

  includeDatabase      Boolean @default(true)
  includeWhatsapp      Boolean @default(true)
  /// Attachments wacli downloaded itself; large, and off by default.
  includeWhatsappMedia Boolean @default(false)
  includeSignal        Boolean @default(true)
  includeMediaCache    Boolean @default(true)
  includeConfig        Boolean @default(true)

  /// Lock each month's snapshot read-only in Drive.
  lockMonthly Boolean @default(true)

  /// AES-256 key every backup is encrypted with (base64). Without it a backup
  /// cannot be restored, so admins keep a copy outside the platform.
  encryptionKey String?

  /// Where failure alerts are emailed (comma-separated); empty disables them.
  alertEmails String @default("")

  updatedById Int?
  updatedAt   DateTime @updatedAt
}

/// One backup run and the snapshot it produced in Google Drive.
model BackupRun {
  id            Int       @id @default(autoincrement())
  /// 'schedule' | 'manual'
  trigger       String
  /// 'running' | 'success' | 'partial' | 'failed'
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  triggeredById Int?

  /// The snapshot's folder in Drive.
  folderId       String?
  folderName     String?
  /// Bytes uploaded (encrypted), across every file.
  sizeBytes      BigInt  @default(0)
  /// Per-file results: component, name, size, md5, Drive id, error.
  files          Json    @default("[]")
  error          String?
  /// Fingerprint of the key the snapshot was encrypted with.
  keyFingerprint String?

  /// Kept regardless of the retention schedule.
  pinned      Boolean   @default(false)
  locked      Boolean   @default(false)
  verifiedAt  DateTime?
  verifyError String?
  /// Removed by retention (moved to the Drive trash).
  prunedAt    DateTime?

  @@index([startedAt])
  @@index([status, prunedAt])
}

// ---------------------------------------------------------------------------
// Map workspace. Geometry is GeoJSON in Json columns: PostGIS is not enabled and
// Prisma has no geometry type, so an Unsupported() column would force every read
// through $queryRaw and break the SELECT/serialize pattern the rest of lib/ uses.
// The only spatial question we ask — is this device inside that zone — is
// answered by lib/geo-geometry.ts over a handful of zones.
// ---------------------------------------------------------------------------

/// A named colour + icon, assignable to imported/drawn features, to zones and to
/// live-tracked devices. Shared org-wide, like Trips and Files.
model MapCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#03458f")
  /// Key into MAP_ICONS in app/modules/map/map-icons.ts.
  icon        String   @default("pin")
  /// feature | device | both — which pickers offer this category.
  scope       String   @default("both")
  sortOrder   Int      @default(0)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User           @relation("MapCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  layers     MapLayer[]
  features   MapFeature[]
  geofences  MapGeofence[]
  deviceTags MapDeviceTag[]

  @@index([sortOrder])
}

/// A group of features: one import, one drawing surface, or an uploaded set of
/// reference borders that draws underneath everything else.
model MapLayer {
  id           Int     @id @default(autoincrement())
  name         String
  /// drawn | import | boundary (an uploaded reference-border layer)
  kind         String  @default("drawn")
  /// kmz | kml | csv — set on imported layers only.
  source       String?
  fileName     String?
  fileMime     String?
  fileSize     Int?
  /// The original upload, kept so it can be downloaded or re-parsed later.
  /// Never included in a list SELECT.
  fileContent  Bytes?
  visible      Boolean @default(true)
  sortOrder    Int     @default(0)
  categoryId   Int?
  /// MapStyle — the layer default its features inherit.
  style        Json?
  /// Bounding box over the layer's features, so "fit to layer" needs no feature read.
  minLat       Float?
  minLng       Float?
  maxLat       Float?
  maxLng       Float?
  featureCount Int     @default(0)

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User         @relation("MapLayerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category  MapCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  features  MapFeature[]

  @@index([kind, sortOrder])
  @@index([categoryId])
}

/// One place or shape. `geometry` is a GeoJSON geometry object.
model MapFeature {
  id           Int      @id @default(autoincrement())
  layerId      Int
  categoryId   Int?
  name         String   @default("")
  description  String?
  /// Point | LineString | Polygon | MultiPoint | MultiLineString | MultiPolygon
  geometryType String
  geometry     Json
  /// KML ExtendedData and surplus CSV columns, kept for the info window.
  properties   Json?
  /// Partial MapStyle overriding the layer default.
  style        Json?
  /// Overrides the category icon for this one feature.
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  layer    MapLayer     @relation(fields: [layerId], references: [id], onDelete: Cascade)
  category MapCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([layerId])
  @@index([categoryId])
}

/// A named zone. Polygons hold a GeoJSON Polygon; circles hold a centre and a
/// radius in metres, because polygonising a circle loses the radius on edit.
model MapGeofence {
  id          Int      @id @default(autoincrement())
  name        String
  /// polygon | circle | rectangle
  shape       String   @default("polygon")
  geometry    Json
  /// MapStyle.
  style       Json?
  visible     Boolean  @default(true)
  categoryId  Int?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User         @relation("MapGeofenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category  MapCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([visible])
}

/// Category, icon and label overrides for a live-tracked device. Keyed by the
/// Zello username rather than an FK: ZelloDeviceLocation rows are keyed by
/// (network, channel, device) and churn, but the username is stable.
model MapDeviceTag {
  id         Int      @id @default(autoincrement())
  device     String   @unique
  categoryId Int?
  icon       String?
  label      String?
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category MapCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}
