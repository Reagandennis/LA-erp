generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  name           String
  passwordHash   String
  status         String     @default("active")
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userRoles      UserRole[]
  userModules    UserModule[]
  personalTodos  PersonalTodo[]
  personalTodoBoard PersonalTodoBoard?
  personalTodoAttachments PersonalTodoAttachment[]
  personalTodoShares PersonalTodoShare[]
  personalTodoNotifications PersonalTodoNotification[]
  personalTodoComments PersonalTodoComment[]
  sessions       Session[]
  auditLogs      AuditLog[] @relation("AuditActor")
  auditTargets   AuditLog[] @relation("AuditTarget")
  createdCustomers   Customer[] @relation("CustomerCreatedBy")
  createdQuotes      Quote[]    @relation("QuoteCreatedBy")
  approvableQuotes   Quote[]    @relation("QuoteApprover")
  quoteNotifications QuoteNotification[]
  createdProducts    Product[]       @relation("ProductCreatedBy")
  createdQuoteTemplates QuoteTemplate[] @relation("QuoteTemplateCreatedBy")
  organizationUpdates OrganizationSettings[] @relation("OrganizationUpdatedBy")
  createdTrips       Trip[]          @relation("TripCreatedBy")
  ownedTrips         Trip[]          @relation("TripOwner")
  tripItineraryItemNotifications TripItineraryItemNotification[]
  createdConversations Conversation[] @relation("ConversationCreatedBy")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]      @relation("MessageSender")
  messageNotifications MessageNotification[]
  feedback             Feedback[]     @relation("FeedbackAuthor")
  feedbackUpvotes      FeedbackUpvote[]
  feedbackComments     FeedbackComment[]
  createdDriverLicenses DriverLicense[] @relation("DriverLicenseCreatedBy")
  uploadedFiles        StoredFile[]   @relation("StoredFileUploadedBy")
  receivedFileShares   StoredFileShare[]
  fileNotifications    FileNotification[]
  calendarEvents       CalendarEvent[]
  calendarEventNotifications CalendarEventNotification[]
  scheduleShifts        ScheduleShift[] @relation("ScheduleEmployee")
  createdScheduleShifts ScheduleShift[] @relation("ScheduleCreatedBy")
}

model PersonalTodo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("Backlog")
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments PersonalTodoAttachment[]
  shares      PersonalTodoShare[]
  notifications PersonalTodoNotification[]
  comments    PersonalTodoComment[]
  subtasks    Json?

  @@index([userId, completed, dueDate])
  @@index([userId, createdAt])
}

model PersonalTodoAttachment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoShare {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([userId, createdAt])
}

model PersonalTodoNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  todoId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PersonalTodoComment {
  id        Int      @id @default(autoincrement())
  todoId    Int
  userId    Int
  body      String
  createdAt DateTime @default(now())
  todo      PersonalTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId, createdAt])
}

model PersonalTodoBoard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  columns     Json
  columnColors Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String       @unique
  description String
  category    String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userModules UserModule[]

  @@index([category, sortOrder])
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserModule {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String?
  actorUserId  Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  billingAddress String?
  createdById    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotes         Quote[]
  trips          Trip[]

  @@index([createdById, createdAt])
  @@index([name])
}

model Quote {
  id             Int       @id @default(autoincrement())
  reference      String    @unique
  trackingCode   String?   @unique
  customerId     Int
  createdById    Int
  approverId     Int?
  subject        String
  status         String    @default("Draft")
  issueDate      DateTime
  expiryDate     DateTime
  currency       String    @default("USD")
  taxRate        Decimal   @default(0) @db.Decimal(6, 4)
  discountType   String    @default("none")
  discountValue  Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(14, 2)
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  terms          String?
  decisionNote   String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      User      @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approver       User?     @relation("QuoteApprover", fields: [approverId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  notifications  QuoteNotification[]
  trip           Trip?     @relation("QuoteSourceTrip")

  @@index([createdById, status])
  @@index([approverId, status])
  @@index([customerId])
  @@index([status, expiryDate])
  @@index([trackingCode])
}

model QuoteItem {
  id             Int     @id @default(autoincrement())
  quoteId        Int
  position       Int
  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(14, 2)
  taxable        Boolean @default(true)
  discountType   String  @default("none")
  discountValue  Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)
  productId      Int?
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tripItineraryItems TripItineraryItem[] @relation("QuoteItemSourceItinerary")

  @@index([quoteId, position])
  @@index([productId])
}

model QuoteNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  quoteId   Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quoteId])
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  sku              String?
  defaultUnitPrice Decimal  @default(0) @db.Decimal(14, 2)
  currency         String   @default("USD")
  taxable          Boolean  @default(true)
  archived         Boolean  @default(false)
  createdById      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User     @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quoteItems       QuoteItem[]

  @@index([archived, name])
  @@index([createdById])
}

model QuoteTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  taxRate       Decimal  @default(0) @db.Decimal(6, 4)
  currency      String   @default("USD")
  terms         String?
  notes         String?
  discountType  String   @default("none")
  discountValue Decimal  @default(0) @db.Decimal(14, 2)
  items         Json     @default("[]")
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation("QuoteTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, name])
}

model OrganizationSettings {
  id              Int      @id @default(1)
  companyName     String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String?
  email           String?
  phone           String?
  website         String?
  defaultCurrency String   @default("USD")
  defaultTaxRate  Decimal  @default(0) @db.Decimal(6, 4)
  taxLabel        String   @default("Tax")
  logo            Bytes?
  logoMimeType    String?
  updatedById     Int?
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model QuoteSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model Trip {
  id            Int       @id @default(autoincrement())
  reference     String    @unique
  trackingCode  String    @unique
  customerId    Int
  sourceQuoteId Int?      @unique
  createdById   Int
  ownerId       Int?
  title         String
  description   String?
  status        String    @default("Draft")
  startDate     DateTime?
  endDate       DateTime?
  currency      String    @default("USD")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceQuote   Quote?    @relation("QuoteSourceTrip", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  createdBy     User      @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  owner         User?     @relation("TripOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items         TripItineraryItem[]

  @@index([createdById, status])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([trackingCode])
}

model TripItineraryItem {
  id                    Int       @id @default(autoincrement())
  tripId                Int
  position              Int
  itemType              String    @default("activity")
  description           String
  subtitle              String?
  quantity              Decimal   @db.Decimal(12, 2)
  unitPrice             Decimal?  @db.Decimal(14, 2)
  completedAt           DateTime?
  sourceQuoteItemId     Int?
  scheduledAt           DateTime?
  endsAt                DateTime?
  durationMinutes       Int?
  reminderMinutesBefore Int?
  reminderAt            DateTime?
  reminderSentAt        DateTime?
  imageUrl              String?
  confirmationCode      String?
  trip                  Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceQuoteItem       QuoteItem? @relation("QuoteItemSourceItinerary", fields: [sourceQuoteItemId], references: [id], onDelete: SetNull)
  notifications         TripItineraryItemNotification[]

  @@index([tripId, position])
  @@index([tripId, scheduledAt])
  @@index([reminderAt, reminderSentAt])
  @@index([sourceQuoteItemId])
}

model TripItineraryItemNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  item      TripItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TripSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model TrackingSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}

model Conversation {
  id          Int      @id @default(autoincrement())
  type        String   @default("direct")
  title       String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             Int       @id @default(autoincrement())
  conversationId Int
  userId         Int
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  notifications  MessageNotification[]

  @@index([conversationId, createdAt])
}

model MessageNotification {
  id             Int       @id @default(autoincrement())
  userId         Int
  messageId      Int
  conversationId Int
  type           String
  message        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageRef     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, conversationId])
}

model Feedback {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String   @default("Improvement")
  status      String   @default("New")
  authorId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  upvotes     FeedbackUpvote[]
  comments    FeedbackComment[]

  @@index([status, createdAt])
  @@index([category, createdAt])
}

model FeedbackUpvote {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  userId     Int
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([userId])
}

model FeedbackComment {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  userId     Int
  body       String
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

model DriverLicense {
  id              Int      @id @default(autoincrement())
  driverName      String
  licenseNumber   String
  category        String   @default("Class A")
  expiryDate      DateTime
  lastVerified    DateTime?
  notes           String?
  documentName    String?
  documentMime    String?
  documentSize    Int?
  documentContent Bytes?
  createdById     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation("DriverLicenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([driverName])
}

model StoredFile {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  mimeType     String
  size         Int
  content      Bytes
  uploadedById Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("StoredFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  shares       StoredFileShare[]
  notifications FileNotification[]

  @@index([createdAt])
  @@index([uploadedById])
}

model StoredFileShare {
  id        Int      @id @default(autoincrement())
  fileId    Int
  userId    Int
  createdAt DateTime @default(now())
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([userId])
}

model FileNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  fileId    Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CalendarEvent {
  id                    Int       @id @default(autoincrement())
  userId                Int
  title                 String
  description           String?
  location              String?
  tag                   String?
  startsAt              DateTime
  endsAt                DateTime?
  allDay                Boolean   @default(false)
  reminderMinutesBefore Int?
  reminderAt            DateTime?
  reminderSentAt        DateTime?
  googleEventId         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications         CalendarEventNotification[]

  @@index([userId, startsAt])
  @@index([reminderAt, reminderSentAt])
}

model CalendarEventNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  eventId   Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ScheduleShift {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  date           String   // 'YYYY-MM-DD'
  type           String
  startTime      String?
  endTime        String?
  timeLabel      String?
  statusLabel    String?
  note           String?
  tasksCompleted Int?
  totalTasks     Int?
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       User     @relation("ScheduleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}
