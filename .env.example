# ---------------------------------------------------------------------------
# LA-ERP environment template
#
#   cp .env.example .env      then fill in the values below.
#
# Only the "Required" block is needed to boot the platform. Every optional
# integration degrades gracefully when its variables are unset — the module
# stays visible and reports that it needs configuration.
# ---------------------------------------------------------------------------

# === Required ==============================================================

# PostgreSQL connection string.
# The bundled docker-compose.yml exposes Postgres on host port 5433
# (database / user / password are all "la_erp").
DATABASE_URL="postgresql://la_erp:la_erp@localhost:5433/la_erp"

# Time zone the server formats dates and times in. Set it to the business's
# zone so server-rendered pages match what users' browsers show (a mismatch
# makes React re-render the whole page on the client). Example: Africa/Nairobi
TZ=

# Set to "true" once the reverse proxy compresses responses (Caddy:
# `encode zstd gzip`). Next.js then skips its own gzip, saving CPU on the app
# server. Read at build time, so rebuild after changing it.
REVERSE_PROXY_COMPRESSION=

# Secret used to sign session JWTs. The app fails fast if this is unset.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# The administrator created (or updated) by `npm run db:seed`.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="Administrator"
BOOTSTRAP_ADMIN_PASSWORD=""
# Set to 1 for a single seed run to reset an existing admin's password.
BOOTSTRAP_ADMIN_FORCE_PASSWORD=""


# === AI (AI Chatbot, Intel, transcription) =================================

# Google AI Studio key. AI_ASSISTANT_API_KEY takes precedence over GEMINI_API_KEY.
AI_ASSISTANT_API_KEY=""
GEMINI_API_KEY=""
# Model overrides (defaults shown).
AI_ASSISTANT_MODEL="gemini-3.5-flash"
AI_SEARCH_MODEL="gemini-3.1-flash-lite"
# How much each AI feature "thinks" before answering: minimal | low | medium | high.
# Thinking is billed as output (the dearest tokens); unset, Flash models think at medium.
AI_ASSISTANT_THINKING="low"
AI_SEARCH_THINKING="minimal"
INTEL_RESEARCH_THINKING="low"
INTEL_STRUCTURE_THINKING="minimal"
ZELLO_TRANSCRIBE_THINKING="minimal"
# Spending limits (daily/monthly budget, per-person allowances) are set in
# Admin → Settings → AI usage. The hard stop is a prepaid balance in AI Studio.
GEMINI_MODEL=""


# === Maps ==================================================================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Vector map style id; defaults to DEMO_MAP_ID (watermarked) when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
# Server-side Maps key for Intel geocoding; falls back to the public key above.
GOOGLE_MAPS_API_KEY=""
# Optional CARTO basemap key.
NEXT_PUBLIC_CARTO_API_KEY=""


# === Google sign-in / Drive (Storage module) ===============================

NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Comma-separated Workspace domains allowed to sign in (empty = no restriction).
GOOGLE_ALLOWED_HD=""


# === Email (SMTP) ==========================================================

SMTP_HOST=""
SMTP_PORT="587"
# "true"/"false"; leave blank to infer from the port (465 = TLS).
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER when unset.
EMAIL_FROM="LA-ERP <noreply@example.com>"
EMAIL_REPLY_TO=""


# === Accounting: QuickBooks Online =========================================

QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
# "sandbox" (default) or "production".
QUICKBOOKS_ENVIRONMENT="sandbox"


# === Accounting: Wave (waveapps.com) =======================================

WAVE_CLIENT_ID=""
WAVE_CLIENT_SECRET=""
WAVE_REDIRECT_URI="http://localhost:3000/api/wave/callback"
# Optional: pin a specific Wave business instead of using the first one.
WAVE_BUSINESS_ID=""


# === Radio / Zello Work ====================================================

ZELLO_NETWORK="ladyaskari"
ZELLO_API_KEY=""
ZELLO_USERNAME="admin"
ZELLO_PASSWORD=""
# RS256 credentials for the browser token endpoint.
ZELLO_ISSUER=""
# PEM private key — escape newlines as \n on a single line.
ZELLO_PRIVATE_KEY=""
ZELLO_CHANNEL=""
# Days of channel activity to retain (default 120).
ZELLO_RETENTION_DAYS="120"
# Transcription model (default gemini-3.1-flash-lite, the cheapest Gemini for audio).
ZELLO_TRANSCRIBE_MODEL=""


# === Messaging (WhatsApp / Signal / Telegram) ==============================

# WhatsApp runs through wacli (https://wacli.sh). The bundled docker-compose.yml
# ships it as the `wacli` service, so nothing needs installing on the host:
# set WACLI_CONTAINER to that container's name and the app runs every wacli
# command inside it with `docker exec` (the app's user must be able to run
# `docker`). The app starts the container at boot if it isn't running.
WACLI_CONTAINER="la-erp-wacli"
# Alternative: wacli installed on the host. Leave WACLI_CONTAINER empty and
# point this at the binary (default: "wacli" on PATH).
WACLI_BIN=""
# Where `wacli sync` posts inbound messages. Defaults to APP_INTERNAL_URL, with
# localhost rewritten to host.docker.internal in container mode. Set this only
# if the app is not reachable that way (e.g. `network_mode: host` in compose).
WACLI_WEBHOOK_BASE=""
# Path to the docker CLI (default: "docker" on PATH).
DOCKER_BIN=""
# Set to 1 to have wacli pre-download every attachment in a linked account's
# history (gigabytes for an active account). Off by default: attachments are
# fetched on demand when a thread is opened and cached for later.
WACLI_DOWNLOAD_MEDIA=""
# Memory cap for the wacli container (docker-compose); default 1g.
WACLI_MEM_LIMIT=""
# Absolute path to signal-cli (default: "signal-cli" on PATH).
SIGNAL_CLI_BIN=""
# signal-cli's data directory, included in backups (default: ~/.local/share/signal-cli).
SIGNAL_CLI_DATA_DIR=""
# Where chat attachments are cached. Set a permanent path in production: the
# default (system temp dir) can be wiped on reboot, and for WhatsApp media that
# its servers have expired, this cache is the only copy.
MESSAGING_MEDIA_CACHE_DIR=""

# --- Backups (configured in Admin → Settings → Backups) ---------------------
# Run pg_dump inside this Postgres container instead of on the host. Used
# automatically with the bundled "la-erp-postgres" when the host has no pg_dump.
BACKUP_PG_CONTAINER=""
# Host pg_dump to use (default: "pg_dump" on PATH); must match the server's major version.
PG_DUMP_BIN=""
# Telegram app credentials from https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Shared secret for inbound messaging webhooks; generated per-install if unset.
MESSAGING_WEBHOOK_SECRET=""
# Base URL the sync workers call back on (default http://127.0.0.1:3000).
APP_INTERNAL_URL="http://127.0.0.1:3000"


# === Fleet tracking (Traccar) ==============================================

TRACCAR_URL=""
TRACCAR_TOKEN=""


# === Flight tracker ========================================================

FR24_API_TOKEN=""
OPENSKY_USERNAME=""
OPENSKY_PASSWORD=""
